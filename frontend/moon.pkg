// The MAKED frontend: a rabbita single-page app.
//
// This is a library package so the views can be tested without a browser; the
// bundle is produced by `cmd/web`, which is the executable that mounts it.
//
// `Json` is a builtin and needs no import, and `assert_eq`/`assert_true` come
// from the prelude, so neither `moonbitlang/core/json` nor
// `moonbitlang/core/test` is listed: importing either is an `unused_package`
// warning. `string` is listed in the main block because `entries.mbt` parses a
// record id with it; a `for "test"` block is not needed on top of that, since
// the main imports are available to the test build too. `double` is not
// listed at all: `sqrt`/`abs` resolve as `Double` methods without it.
import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/http",
  "moonbit-community/rabbita/nav",
  "moonbit-community/rabbita/sub",
  "moonbit-community/rabbita/svg",
  "moonbit-community/rabbita/url",
  "moonbitlang/core/math",
  "moonbitlang/core/string",
}

supported_targets = "js"
