digraph evolution {
  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  
  subgraph cluster_current {
    label="Current Architecture (Prototype Stage)";
    style=dashed;
    color=gray60;
    
    node [shape=box, style=filled, fillcolor=lightblue];
    
    cmd_server [label="cmd/server\n(native exe)"];
    cmd_web [label="cmd/web\n(js exe)"];
    backend [label="backend\n(native lib)\n─────────\napi.mbt\nloop.mbt (global state)\npages.mbt\ndatabase.mbt"];
    frontend [label="frontend\n(js lib)\n─────────\napp.mbt\nviews.mbt\nloop_state.mbt"];
    pyroduct [label="pyroduct\n(external dependency)\n─────────\nmigration table: all Block"];
    
    cmd_server -> backend [label="import @maked"];
    cmd_web -> frontend [label="import"];
    backend -> pyroduct [label="@sm.step()\nreturns Block"];
    backend -> backend [label="g_loop_state[0]\nmodule-level global", style=dotted];
  }
  
  subgraph cluster_target {
    label="Target Architecture (Production-Ready)";
    style=dashed;
    color=gray60;
    
    node [shape=box, style=filled, fillcolor=lightgreen];
    
    cmd_server_t [label="cmd/server\n(native exe)"];
    cmd_web_t [label="cmd/web\n(js exe)"];
    app_layer [label="Application Layer\n─────────\nAppContext\nDependency Injection\nConfig Loading"];
    backend_t [label="backend\n(native lib)\n─────────\nDomain Logic\n(no global state)"];
    infra [label="Infrastructure Layer\n─────────\nDatabase\nLogger\nMetrics"];
    frontend_t [label="frontend\n(js lib)\n─────────\nSlot Selector\nConfig-Driven"];
    pyroduct_t [label="pyroduct\n(external dependency)\n─────────\nmigration table: valid migration"];
    config [label="Configuration System\n─────────\nloop_config.json\nEnvironment Variables"];
    
    cmd_server_t -> app_layer;
    cmd_web_t -> frontend_t;
    app_layer -> backend_t;
    app_layer -> infra;
    app_layer -> config [label="loads config"];
    backend_t -> pyroduct_t [label="@sm.step()\nreturns Moved/Held"];
    frontend_t -> app_layer [label="API call\n(with slot parameter)"];
  }
  
  // Migration arrows
  edge [style=bold, color=red, constraint=false];
  backend -> app_layer [label="Slice 3:\nState Management\nRefactor"];
  pyroduct -> pyroduct_t [label="Slice 1:\nUnlock migration table\nor wrapper logic"];
  frontend -> frontend_t [label="Slice 1:\nAdd slot\nselector"];
  backend_t -> config [label="Slice 4:\nConfig-Driven"];
  infra -> backend_t [label="Slice 5:\nPersistence"];
  
  // Legend
  subgraph cluster_legend {
    label="Legend";
    style=solid;
    color=black;
    
    node [shape=plaintext];
    legend [label=<
      <table border="0" cellborder="1" cellspacing="0">
        <tr><td bgcolor="lightblue">Current component</td></tr>
        <tr><td bgcolor="lightgreen">Target component</td></tr>
        <tr><td><font color="red">→</font></td><td>Migration path</td></tr>
      </table>
    >];
  }
}
