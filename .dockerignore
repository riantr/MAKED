# Keep the build context small and the image reproducible.
#
# The two exclusions that matter:
#   .mooncakes/  the vendored dependency tree -- hundreds of megabytes, and
#                the image reinstalls it from the registry anyway;
#   frontend/dist/main.js  the generated browser bundle -- the image builds
#                its own, from the source in this context.
#
# Note that frontend/dist/index.html and frontend/dist/styles.css are NOT
# excluded: they are tracked source, not build output, and the server serves
# them.

.git
.github
.gitignore
_build
.mooncakes
moonbit-debug.log

# Generated browser bundle -- rebuilt inside the image.
frontend/dist/main.js

# Local state and scratch.
*.db
*.db-journal
*.db-wal
*.db-shm
_stdout.txt
_stderr.txt
_s.log
_s.err
_s.out
_dbg
_reqlog
_probe*
_smoke*
_maked_wsl_probe*

# Docs and tooling that the image does not need. README.md and LICENSE stay in
# the context: moon.mod names the README, and a missing file that a tool
# expects is a worse problem than a few kilobytes of context.
architecture/evolution-roadmap.md
architecture/current-vs-target.dot
architecture/evolution-summary.md
architecture/migration-dependency.dot
build.ps1
ci.sh
tools
