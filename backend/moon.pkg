// maked: a small Flask-style micro-framework built on moonback.
//
// The shape deliberately echoes Flask: an `App` owns a route table and an
// ordered middleware chain, handlers are registered per method+path, and
// responses are values rather than side effects on a global. Everything is
// a thin, honest layer over `moonback` -- the goal is a readable MAKED
// server, not a general-purpose framework.
import {
  "moonbit-community/sqlite3",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/core/debug",
  "moonbitlang/moonback",
  "moonbitlang/moonback/middlewares/unstable_static" @static,
  "riantr/moonbit_doubleML" @dml,
  "riantr/pyroduct/group",
  "riantr/pyroduct/src" @sm,
}

// `moonbitlang/core/test` is deliberately absent: `assert_eq`/`assert_true`
// come from the prelude, so importing it is an `unused_package` warning.
import {
  "moonbitlang/async",
} for "test"

supported_targets = "native"
