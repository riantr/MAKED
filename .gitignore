# MoonBit build output
/_build/

# Vendored dependencies. `moon add` re-fetches these from mooncakes.io; they
# are a cache, not source, and the lockfile in .mooncakes/ pins the versions.
/.mooncakes/

# The staged browser bundle is generated by build.ps1 from the js build.
# The shell (index.html, styles.css) is source and IS tracked.
/frontend/dist/main.js

# Local SQLite database
*.db
*.db-journal
*.db-wal
*.db-shm

# Local server log captures from ad-hoc QA runs
/_s.log
/_s.err
/_s.out
