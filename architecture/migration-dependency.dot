// This document describes the past.
//
// The dependencies between the migration slices, and the critical path
// through them, as they were worked out when the tree was a prototype.
// Every slice has since been implemented, or deliberately deferred. The
// reasoning is the point -- but read it as history.
//
// For the system as it is today, read architecture/system-model.md and the
// README.

digraph migration_dependencies {
  rankdir=LR;
  label="This document describes the past.\nThe slices, their dependencies, and the critical path."
  labelloc="t"
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, shape=box, style=filled];
  edge [fontname="Helvetica", fontsize=9];
  
  // Phase 1: Immediate
  node [fillcolor=lightcoral];
  slice1 [label="Slice 1\nUnlock Loop\nforward progress\n─────────\nPriority: High\nRisk: Low\nEffort: 1-2 days"];
  slice2 [label="Slice 2\nIntegration Testing\nInfrastructure\n─────────\nPriority: High\nRisk: Medium\nEffort: 2-3 days"];
  
  // Phase 2: Short-term
  node [fillcolor=lightyellow];
  slice3 [label="Slice 3\nState Management\nRefactor\n─────────\nPriority: Medium\nRisk: High\nEffort: 3-5 days"];
  slice4 [label="Slice 4\nConfiguration\nSystem\n─────────\nPriority: Medium\nRisk: Low\nEffort: 2-3 days"];
  
  // Phase 3: Medium-term
  node [fillcolor=lightgreen];
  slice5 [label="Slice 5\nState Persistence\n─────────\nPriority: Low\nRisk: Medium\nEffort: 2-3 days"];
  slice6 [label="Slice 6\nObservability\n─────────\nPriority: Low\nRisk: Low\nEffort: 2-3 days"];
  
  // Dependencies
  edge [color=blue, style=solid];
  slice2 -> slice3 [label="safety net\n(integration tests\nmust come first)"];
  slice3 -> slice4 [label="Context\npassing\nConfig"];
  slice3 -> slice5 [label="Context\nmanagement\nDatabase"];
  slice3 -> slice6 [label="Context\npassing\nLogger"];
  
  // Parallel paths
  edge [color=gray, style=dashed];
  slice1 -> slice2 [label="can run in parallel\n(no dependency)", constraint=false];
  
  // Critical path
  edge [color=red, penwidth=2];
  slice1 -> slice3 [label="critical path", constraint=false];
  
  // Milestones
  node [shape=diamond, fillcolor=gold, width=2];
  m1 [label="Milestone 1\nLoop runnable"];
  m2 [label="Milestone 2\nTest safety net"];
  m3 [label="Milestone 3\nArchitecture solid"];
  m4 [label="Milestone 4\nProduction-ready"];
  
  edge [style=dotted, color=darkgreen];
  slice1 -> m1;
  slice2 -> m2;
  slice3 -> m3;
  slice4 -> m3;
  slice5 -> m4;
  slice6 -> m4;
  
  // Legend
  subgraph cluster_legend {
    label="Legend";
    style=solid;
    
    node [shape=plaintext, fillcolor=white];
    legend [label=<
      <table border="0" cellborder="1" cellspacing="0">
        <tr><td bgcolor="lightcoral">Phase 1: Immediate</td></tr>
        <tr><td bgcolor="lightyellow">Phase 2: Short-term</td></tr>
        <tr><td bgcolor="lightgreen">Phase 3: Medium-term</td></tr>
        <tr><td><font color="red">→</font></td><td>critical path</td></tr>
        <tr><td><font color="blue">→</font></td><td>dependency</td></tr>
        <tr><td><font color="gray">- -→</font></td><td>can run in parallel</td></tr>
      </table>
    >];
  }
}
